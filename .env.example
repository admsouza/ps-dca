# Variáveis da DCA. Copie para `.env` e ajuste.
#
# Nomes iguais aos de `regras-rreo-api` e `regras-rgf-api` sempre que significam o mesmo:
# num monolito modular, nome divergente para o mesmo conceito transforma o `.env` de
# produção em adivinhação. A referência de valores é `regras-rreo-api/.env`, que roda em
# produção — inclusive as credenciais do hub.

# ─── Fonte SICONFI (pública, sem token) ──────────────────────────────────────
SICONFI_API_URL=https://apidatalake.tesouro.gov.br/ords/siconfi
SICONFI_TIMEOUT=30
SICONFI_POOL_MAXSIZE=12

# ─── Fonte PublicSoft (exige token do ente por requisição) ───────────────────
PUBLICSOFT_API_URL=
PUBLICSOFT_AUDIT_URL=
PUBLICSOFT_TIMEOUT=120
PUBLICSOFT_SSL_VERIFY=false

# ─── Execução e fonte padrão ─────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=False
DATA_SOURCE=siconfi

# ─── Logs (verbosidade por componente, padrão do RREO) ───────────────────────
LOG_LEVEL=WARNING
APP_LOG_LEVEL=WARNING
WORKER_LOG_LEVEL=WARNING
ARQ_LOG_LEVEL=WARNING
PIPELINE_LOG_LEVEL=WARNING
NOTIFICATION_LOG_LEVEL=INFO
DIAGNOSTICO_INFRA=false
DIAGNOSTICO_INFRA_DB_MIN_MS=25

# =============================================================================
# F2 e F3 — plataforma (change `plataforma-pipeline-dca`)
# =============================================================================

# --- Postgres COMPARTILHADO com RREO e RGF -----------------------------------
# Mesmo banco `db-ps-rreo-rgf-dca`, schema `public`. A separacao da DCA e por
# prefixo `dca_*` nas tabelas e `alembic_version_dca` -- NAO por schema (P5).
# Credenciais: as mesmas do hub. O RREO as declara em `DATABASE_URL`; aqui vao
# decompostas em `POSTGRES_*`, como no RGF. Host `host.docker.internal` e o que
# os containers usam para alcancar o Postgres do host; fora de container, `localhost`.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=db-ps-rreo-rgf-dca
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_CONNECT_TIMEOUT=10
RUN_MIGRATIONS=false
ALEMBIC_LOCK_TIMEOUT_SECONDS=30

# --- Redis -------------------------------------------------------------------
# `REDIS_HOST=redis_cache` e o container da rede externa `ps-infra`, o mesmo dos
# irmaos. `REDIS_PREFIX` e compartilhado DE PROPOSITO: nomeia o cache de MSC, que
# serve os tres pipelines. O que se isola e o estado de execucao -- fila
# `arq:queue:dca` e chaves `dca:`.
REDIS_HOST=redis_cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=msc_cache:
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=120

# --- Fila, job e web ---------------------------------------------------------
DCA_ARQ_QUEUE_NAME=arq:queue:dca
DCA_JOB_TIMEOUT_SECONDS=3600
DCA_JOB_TTL_SECONDS=3600
PIPELINE_MAX_CONCORRENTES=2
WEB_WORKERS=1
WEB_TIMEOUT=300

# --- Auth --------------------------------------------------------------------
# `SECRET_KEY` e `S2S_API_SECRET` sao as DO HUB, iguais as de RREO/RGF: o JWT e
# `HS256` verificado localmente, e chave propria nao validaria token emitido pelo
# hub -- toda rota daria 401. `AUTH_API_URL` confirma usuario ativo.
#
# `TOKEN_ENCRYPTION_KEY` e a excecao: cifra o token de fonte guardado no Redis pelo
# TTL do job, e o RREO nao a tem. Chave DEDICADA, nao derivada do `SECRET_KEY`:
#     python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
S2S_API_SECRET=
AUTH_API_URL=
TOKEN_ENCRYPTION_KEY=

# --- Notificação -------------------------------------------------------------
# Fim de job no canal de operação (P6). Vazio = nada é notificado, e o job roda igual.
DISCORD_WEBHOOK_URL=

# --- Swagger e CORS ----------------------------------------------------------
ENABLE_SWAGGER=False
ENABLE_SWAGGER_PUBLIC=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
