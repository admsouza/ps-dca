# Variáveis da fase F1 (núcleo + CLI). Copie para `.env` e ajuste.
#
# A F1 não sobe API, worker, Postgres nem Redis — as variáveis dessas camadas entram
# com as fases F2 e F3, especificadas em `openspec/changes/plataforma-pipeline-dca/`.
# Nomes iguais aos de `regras-rreo-api` e `regras-rgf-api` sempre que significam o mesmo.

# ─── Fonte SICONFI (pública, sem token) ──────────────────────────────────────
SICONFI_API_URL=https://apidatalake.tesouro.gov.br/ords/siconfi
SICONFI_TIMEOUT=30

# ─── Fonte PublicSoft (exige token do ente por requisição) ───────────────────
PUBLICSOFT_API_URL=http://localhost:3000/contabilidade-tools/matriz-saldo/base-demonstrativos
PUBLICSOFT_AUDIT_URL=http://localhost:3000/contabilidade-tools/matriz-saldo/auditorias
PUBLICSOFT_TIMEOUT=120
PUBLICSOFT_SSL_VERIFY=false

# ─── Execução ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=WARNING
APP_LOG_LEVEL=INFO

# =============================================================================
# F2 e F3 — plataforma (change `plataforma-pipeline-dca`). Sem uso na F1.
# =============================================================================

# --- Postgres COMPARTILHADO com RREO e RGF -----------------------------------
# Mesmo banco `db-ps-rreo-rgf-dca`, schema `public`. A separacao da DCA e por
# prefixo `dca_*` nas tabelas e `alembic_version_dca` -- NAO por schema (P5).
# As credenciais sao as mesmas de `regras-rgf-api`: copie de la.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=db-ps-rreo-rgf-dca
RUN_MIGRATIONS=false
ALEMBIC_LOCK_TIMEOUT_SECONDS=30

# --- Redis -------------------------------------------------------------------
# `REDIS_PREFIX` e compartilhado DE PROPOSITO: nomeia o cache de MSC, que serve
# os tres pipelines. O que se isola e o estado de execucao -- fila
# `arq:queue:dca` e chaves `dca:`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_PREFIX=msc_cache:
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# --- Auth: segredos PROPRIOS da DCA ------------------------------------------
# NUNCA copiar de `regras-rreo-api` nem de `regras-rgf-api` (task 1.6 de
# `plataforma-pipeline-dca`): vazamento em um comprometeria os tres. Gerar com
#   SECRET_KEY / S2S_API_SECRET:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   TOKEN_ENCRYPTION_KEY (Fernet, 32 bytes urlsafe base64):
#     python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
S2S_API_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Swagger e CORS ----------------------------------------------------------
ENABLE_SWAGGER=False
ENABLE_SWAGGER_PUBLIC=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
